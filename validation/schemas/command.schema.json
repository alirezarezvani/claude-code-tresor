{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coderezz/claude-code-tresor/validation/schemas/command.schema.json",
  "title": "Claude Code Tresor Slash Command Frontmatter",
  "description": "Schema for command .md YAML frontmatter. The 'name' field is optional because some legacy flat commands derive their name from the filename.",
  "type": "object",
  "required": ["description", "allowed-tools", "model"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "argument-hint": {
      "type": "string",
      "minLength": 1
    },
    "allowed-tools": {
      "description": "Tool list. Accepts a comma-separated string or a YAML array. May include scoped Bash perms like Bash(git status:*).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
